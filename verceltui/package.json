{
  "name": "verceltui",
  "version": "0.0.3",
  "type": "module",
  "title": "Vercel",
  "description": "View Vercel deployments in the terminal",
  "author": "remorses",
  "license": "MIT",
  "bin": "./bin/cli.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/termcast",
    "directory": "verceltui"
  },
  "homepage": "https://github.com/remorses/termcast/tree/main/verceltui",
  "bugs": "https://github.com/remorses/termcast/issues",
  "keywords": [
    "vercel",
    "tui",
    "terminal",
    "deployments",
    "termcast",
    "cli"
  ],
  "files": [
    "src",
    "bin"
  ],
  "commands": [
    {
      "name": "search-deployments",
      "title": "Search Deployments",
      "description": "List and search your Vercel deployments",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "accessToken",
      "type": "password",
      "required": true,
      "title": "Access Token",
      "description": "Your Vercel access token",
      "placeholder": "Enter your Access Token",
      "link": "https://vercel.com/account/tokens"
    }
  ],
  "scripts": {
    "e2e": "vitest -u",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@termcast/utils": "workspace:^",
    "goke": "^6.14.1",
    "react": "19.2.6",
    "termcast": "workspace:^",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.1.2",
    "tuistory": "workspace:^",
    "typescript": "^5.8.2",
    "vitest": "^4.0.16"
  }
}
